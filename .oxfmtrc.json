{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"singleQuote": true,
	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 80,
	"ignorePatterns": [
		"pnpm-lock.yaml",
		"pnpm-workspace.yaml",
		"dist/**",
		"node_modules/**",
		"src/generated/**",
		"src/prisma/contract.d.ts",
		"src/prisma/contract.json",
		"migrations/snapshots/**"
	],
	"sortImports": true
}
