# Application
# Runtime environment. Accepted values: development, test or production.
NODE_ENV=development
# HTTP port. Rootless Podman deploys must use a value between 1024 and 65535.
PORT=3000
# Application name used by logs and the Swagger document.
API_NAME=Despertar para a Ciência API
# Log level: trace, debug, info, warn, error, fatal or silent.
LOG_LEVEL=info
# Enable delivery through the selected mail driver. local-capture writes only to a local development file.
SEND_EMAILS=false
# Mail implementation: noop skips delivery; brevo sends through Brevo; local-capture stores e-mails locally (development only).
MAIL_DRIVER=noop
# Storage implementation: memory is local/temporary; r2 uses Cloudflare R2.
STORAGE_DRIVER=memory

# HTTP
# Optional comma-separated browser origins allowed by CORS. Empty disables CORS; * allows any origin. Other items must be HTTP(S) URLs.
CORS_ORIGINS=http://localhost:3000
# Enables the Swagger UI at /api and JSON document at /api-json.
SWAGGER_ENABLED=false

# PostgreSQL
# URL used by the API, Prisma migrations and administrative scripts.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/despertar_para_a_ciencia
# URL used by transient verification codes and other ephemeral state.
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK
# Firebase project identifier.
FIREBASE_PROJECT_ID=example-firebase-project
# Optional Firebase Auth Emulator host for local development, e.g. 127.0.0.1:9099.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Service-account private key. Keep the literal \n characters when storing it in dotenv.
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nexample-key\n-----END PRIVATE KEY-----
# Service-account e-mail address.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example-firebase-project.iam.gserviceaccount.com
# Secret of at least 32 characters used to HMAC short-lived email verification codes. Store it in the deployment secret manager.
EMAIL_VERIFICATION_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Web API key used by scripts/generate-token.ts, not by the API runtime.
FIREBASE_WEB_API_KEY=AIzaSyExampleWebApiKey

# Brevo
# Required only when MAIL_DRIVER=brevo. The noop example above does not send mail.
# BREVO_API_KEY=xkeysib-example-brevo-key
# BREVO_SENDER_EMAIL=no-reply@example.com

# Cloudflare R2
# Required only when STORAGE_DRIVER=r2. The memory example above does not use these values.
# CLOUDFLARE_R2_ACCOUNT_ID=example-account-id
# CLOUDFLARE_R2_ACCESS_KEY_ID=example-access-key-id
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=example-secret-access-key
# CLOUDFLARE_R2_BUCKET_NAME=example-bucket
# CLOUDFLARE_R2_PUBLIC_URL=https://example-bucket.example.com

# OpenTelemetry
# OTLP gRPC endpoint. Leave empty to disable telemetry export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Service name reported to the collector. Required when the endpoint is set.
OTEL_SERVICE_NAME=despertar-para-a-ciencia-api
# Controlled by the deployment workflow; contains service.version and deployment.environment.name.
OTEL_RESOURCE_ATTRIBUTES=
# Optional standard OpenTelemetry sampling configuration.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=1.0
# Optional OTLP/gRPC mutual TLS client files. Configure both paths together.
# These are filesystem paths to PEM files, never PEM contents.
# OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/absolute/path/to/otel-client.crt
# OTEL_EXPORTER_OTLP_CLIENT_KEY=/absolute/path/to/otel-client.key
