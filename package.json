{
	"name": "despertar-para-a-ciencia-api",
	"version": "0.0.1",
	"private": true,
	"description": "",
	"license": "UNLICENSED",
	"author": "",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"format": "oxfmt .",
		"format:check": "oxfmt . --check",
		"docs:check": "node scripts/check-docs.mjs",
		"prisma:contract:check": "pnpm prisma contract emit && git diff --exit-code -- src/prisma/contract.json src/prisma/contract.d.ts",
		"prisma:migration:check": "pnpm prisma migration check",
		"start": "nest start",
		"start:dev": "nest start --watch -e \"node --import ./dist/instrumentation.js\"",
		"start:debug": "nest start --debug --watch -e \"node --import ./dist/instrumentation.js\"",
		"start:prod": "node --import ./dist/instrumentation.js dist/main.js",
		"lint": "oxlint",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run --project unit",
		"test:watch": "vitest --project unit",
		"test:cov": "vitest run --project unit --coverage",
		"test:auth-emulator": "FIREBASE_PROJECT_ID=demo-despertar-para-a-ciencia-api firebase emulators:exec --only auth --project demo-despertar-para-a-ciencia-api \"pnpm vitest run --project firebase-auth\"",
		"test:debug": "vitest --project unit --inspect-brk",
		"test:e2e": "vitest run --project e2e",
		"test:release": "node --test test/prepare-release.test.mjs"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1135.0",
		"@nestjs/common": "^12.0.3",
		"@nestjs/config": "^12.0.0",
		"@nestjs/core": "^12.0.3",
		"@nestjs/platform-express": "^12.0.3",
		"@nestjs/swagger": "^12.0.1",
		"@opentelemetry/api": "^1.9.1",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
		"@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
		"@opentelemetry/instrumentation-runtime-node": "^0.35.0",
		"@opentelemetry/sdk-logs": "^0.222.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"@prisma/orm-postgres": "8.0.0-rc.11",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"dotenv": "^18.0.0",
		"file-type": "^22.1.1",
		"firebase-admin": "^14.4.0",
		"multer": "^2.4.0",
		"nestjs-i18n": "^10.8.5",
		"nestjs-pino": "^5.2.0",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.1.3",
		"prisma": "8.0.0-rc.15",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@nestjs/cli": "12.0.3",
		"@nestjs/schematics": "12.0.3",
		"@nestjs/testing": "12.0.3",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.6.1",
		"@types/pg": "8.20.4",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "5.0.1",
		"firebase-tools": "15.30.2",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"oxlint-tsgolint": "^7.0.2001",
		"semver": "^7.8.5",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-loader": "^9.6.2",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vitest": "5.0.1"
	},
	"engines": {
		"node": "24.21.0"
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
